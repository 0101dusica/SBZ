package rules.cep;

import com.ftn.sbnz.model.events.ActivityEvent;
import com.ftn.sbnz.model.models.Recommendation;
import com.ftn.sbnz.model.models.Session;
import com.ftn.sbnz.model.enums.ActivityType;
import com.ftn.sbnz.model.enums.RecommendationType;

// Pravilo 1: Detekcija uzastopnih grešaka
rule "Detect Multiple Errors"
    when
        $session: Session()
        $errors: java.util.List(size >= 3) from collect(
            ActivityEvent(sessionId == $session.id, activityType == ActivityType.ERROR)
        )
    then
        Recommendation recommendation = new Recommendation();
        recommendation.setSessionId($session.getId());
        recommendation.setType(RecommendationType.TAKE_BREAK);
        recommendation.setMessage("Detektovane su česte greške. Potrebna je duža pauza.");
        recommendation.setPriority(1);
        insert(recommendation);
        System.out.println("RULE FIRED: Multiple Errors detected for session " + $session.getId());
end

// Pravilo 2: Detekcija čestih prekidanja rada
rule "Detect Frequent Context Switches"
    when
        $session: Session()
        $switches: java.util.List(size >= 5) from collect(
            ActivityEvent(sessionId == $session.id, activityType == ActivityType.CONTEXT_SWITCH)
        )
    then
        Recommendation recommendation = new Recommendation();
        recommendation.setSessionId($session.getId());
        recommendation.setType(RecommendationType.FOCUS_TIME);
        recommendation.setMessage("Detektovano je previše prekidanja rada. Pokušajte sa fokusiranim radom.");
        recommendation.setPriority(2);
        insert(recommendation);
        System.out.println("RULE FIRED: Frequent Context Switches detected for session " + $session.getId());
end

// Pravilo 3: Detekcija intenzivnog rada
rule "Detect Intensive Work"
    when
        $session: Session()
        $activities: java.util.List(size >= 20) from collect(
            ActivityEvent(sessionId == $session.id,
                         activityType == ActivityType.TYPING ||
                         activityType == ActivityType.MOUSE_CLICK)
        )
    then
        Recommendation recommendation = new Recommendation();
        recommendation.setSessionId($session.getId());
        recommendation.setType(RecommendationType.MICRO_BREAK);
        recommendation.setMessage("Intenzivan rad bez pauze. Preporučuje se kratka pauza.");
        recommendation.setPriority(2);
        insert(recommendation);
        System.out.println("RULE FIRED: Intensive Work detected for session " + $session.getId());
end

// Pravilo 4: Detekcija neaktivnosti
rule "Detect Inactivity"
    when
        $session: Session()
        $idle: java.util.List(size >= 2) from collect(
            ActivityEvent(sessionId == $session.id, activityType == ActivityType.IDLE)
        )
    then
        Recommendation recommendation = new Recommendation();
        recommendation.setSessionId($session.getId());
        recommendation.setType(RecommendationType.TAKE_BREAK);
        recommendation.setMessage("Detektovana je neaktivnost. Preporučuje se pauza.");
        recommendation.setPriority(3);
        insert(recommendation);
        System.out.println("RULE FIRED: Inactivity detected for session " + $session.getId());
end
